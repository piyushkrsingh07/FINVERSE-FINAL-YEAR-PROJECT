# Copy this file to .env and fill in your values
# Never commit .env — it is gitignored

# Backend base URL (used for internal service calls)
BASE_URL=

# Google Gemini AI — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Marketaux Finance News API (primary) — https://www.marketaux.com
MARKETAUX_API_KEY=

# NewsAPI (fallback) — https://newsapi.org
NEWS_API_KEY=

# YouTube Data API v3 (optional, for fetching dynamic playlist videos) — https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Server port (optional, defaults to 8000)
PORT=8000
